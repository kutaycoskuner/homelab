# ----------------------------------------------------------------------------------------
#   aws values for OpenTofu (example) -- copy to terraform.tfvars and fill in; this file is committed
# ----------------------------------------------------------------------------------------
# values in double quotes; one comment above each key: what it is and where to get it
# no secrets: tofu signs in through an AWS CLI profile (README.md, First run)

# Region for the bucket: your account's Region; new AWS project accounts only allow their home Region (README.md)
region = "eu-north-1"

# AWS CLI profile from `aws login --profile <name>`
aws_profile = "<profile-name>"

# Bucket name: unique across all of AWS; lowercase letters, digits, hyphens
bucket_name = "<you>-homelab-backup"

# Monthly cost limit in USD for the alerts, and where they go
budget_limit_usd = 5
budget_email     = "<you@example.net>"

# Optional: days a deleted file stays recoverable (default 30), name of the server's login
# keep_old_versions_days = 30
# backup_user_name       = "homelab-backup"
