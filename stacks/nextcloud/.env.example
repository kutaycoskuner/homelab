# ----------------------------------------------------------------------------------------
#   nextcloud secrets (example) -- copy to .env and fill in; this file is committed
# ----------------------------------------------------------------------------------------
# values in double quotes; one comment above each key: what it is and where to get it

# Password of Nextcloud's own database; only applied on the very first start (empty volume)
NEXTCLOUD_DB_PASSWORD="<your-password>"

# Docker volumes that hold the data. New install: keep these names.
# Existing install: the names from `docker volume ls`, e.g. "nextcloud-stack_db_data",
# or the stack starts empty
NEXTCLOUD_DB_VOLUME_NAME="nextcloud_db_data"
NEXTCLOUD_DATA_VOLUME_NAME="nextcloud_data"
