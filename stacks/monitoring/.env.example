# monitoring -- copy to .env and fill in (python main.py --sync); in Portainer / OpenTofu these are the stack's variables

# URLs to check, comma-separated: public addresses, or internal ones like http://<server-ip>:<port>
PROBE_TARGETS="https://example.net,https://www.example.net"

# Discord webhook the alerts are posted to (docs/integrations/discord-web-hook.md); secret
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/<id>/<token>"
