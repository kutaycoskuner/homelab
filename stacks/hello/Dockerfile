# Test page image. The page is copied in rather than mounted, because a Portainer stack
# deployed from Git can't bind-mount files from the repo.
FROM nginx:alpine@sha256:785835ea65db4bba6f021acc0f3be91b0fef76a53fe41f8588c6698d2aed0606
COPY index.html /usr/share/nginx/html/index.html
