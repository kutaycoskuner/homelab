# ----------------------------------------------------------------------------------------
#   cloudflared secrets (example) -- copy to .env and fill in; this file is committed
# ----------------------------------------------------------------------------------------
# values in double quotes; one comment above each key: what it is and where to get it

# Cloudflare Tunnel token: anyone with it can run your tunnel
#   Cloudflare dashboard: Networking > Tunnels > your tunnel > Docker install command, the part after --token
#   docs/03-exposing-services.md
CLOUDFLARE_TUNNEL_TOKEN="<tunnel-token>"
