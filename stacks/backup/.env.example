# backup -- copy to .env and fill in (python main.py --sync); in Portainer / OpenTofu these are the stack's variables

# Where the backups go: s3:s3.<region>.amazonaws.com/<bucket-name> (tofu/aws outputs: region, bucket_name)
RESTIC_REPOSITORY="s3:s3.<region>.amazonaws.com/<bucket-name>"

# Encrypts every backup; keep it in your password manager: without it the backups can't be read; secret
RESTIC_PASSWORD="<long-random-password>"

# The bucket's login (tofu/aws outputs: backup_access_key_id, backup_secret_access_key); secret
AWS_ACCESS_KEY_ID="<backup-access-key-id>"
AWS_SECRET_ACCESS_KEY="<backup-secret-access-key>"

# The postgres stack: its network and container name, and a user that can read every database,
# best a read-only one (tofu/postgres: role pg_read_all_data) rather than the admin; secret
# network: check with  docker inspect postgres-core --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}'
POSTGRES_NETWORK="db_network"
POSTGRES_HOST="postgres-core"
POSTGRES_USER="appuser"
POSTGRES_PASSWORD="<your-password>"

# Folders on the server that are backed up too (read-only)
MEDIA_DIR="/srv/media-server/data-images"
ADGUARD_CONF_DIR="/home/<user>/docker/adguard/conf"

# Discord webhook for failure messages (docs/integrations/discord-web-hook.md); secret
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/<id>/<token>"

# When: cron format (minute hour day month weekday), in the time zone below
BACKUP_SCHEDULE="0 3 * * *"
TZ="Europe/Berlin"
