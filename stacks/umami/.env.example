# ----------------------------------------------------------------------------------------
#   umami secrets (example) -- copy to .env and fill in; this file is committed
# ----------------------------------------------------------------------------------------
# values in double quotes; one comment above each key: what it is and where to get it

# Database and user created for umami on the postgres stack (docs/stack-postgres.md)
UMAMI_DB_NAME="umamidb"
UMAMI_DB_USER="umami_user"

# That user's password; it goes into a URL, so use letters and digits only (or URL-encode it)
UMAMI_DB_PASSWORD="<your-password>"

# Random secret that signs login sessions; create one with: openssl rand -hex 32
UMAMI_APP_SECRET="<random-hex-secret>"
