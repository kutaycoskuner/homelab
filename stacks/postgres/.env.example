# ----------------------------------------------------------------------------------------
#   postgres secrets (example) -- copy to .env and fill in; this file is committed
# ----------------------------------------------------------------------------------------
# values in double quotes; one comment above each key: what it is and where to get it

# Database admin user and its password; only used on the very first start (empty volume),
# changing them later doesn't change an existing database
POSTGRES_USER="appuser"
POSTGRES_PASSWORD="<your-password>"

# Database created on the first start
POSTGRES_DB="appdb"

# Docker volume that holds the data. New install: keep "postgres_data".
# Existing install: the name from `docker volume ls`, e.g. "postgres-stack_postgres_data",
# or the stack starts with an empty database
POSTGRES_VOLUME_NAME="postgres_data"

# pgAdmin web UI login (any e-mail address works as the user name)
PGADMIN_DEFAULT_EMAIL="admin@example.net"
PGADMIN_DEFAULT_PASSWORD="<your-password>"
