# ----------------------------------------------------------------------------------------
#   adguard settings (example) -- copy to .env and fill in; this file is committed
# ----------------------------------------------------------------------------------------
# values in double quotes; one comment above each key: what it is and where to get it

# Folder on the server for AdGuard's settings (conf/) and statistics (work/); not a secret,
# but it differs per server. An existing install: point it at the folder that holds conf/ and work/.
ADGUARD_DATA_DIR="/home/<user>/docker/adguard"
