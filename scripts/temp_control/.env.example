# ----------------------------------------------------------------------------------------
#   temp_control secrets (example) -- copy to .env and fill in; this file is committed
# ----------------------------------------------------------------------------------------
# values in double quotes; one comment above each key: what it is and where to get it

# Discord webhook for the daily temperature report and the shutdown alert
#   Discord: Server Settings > Integrations > Webhooks > Copy Webhook URL
#   docs/integrations/discord-web-hook.md
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/<id>/<token>"
